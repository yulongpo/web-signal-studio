# If unset, a random Bearer token is generated at startup and logged once.
LOCAL_COMPUTE_TOKEN=
LOCAL_COMPUTE_HOST=127.0.0.1
LOCAL_COMPUTE_PORT=8000
LOCAL_COMPUTE_CORS_ORIGINS=http://localhost:5173

# Primary model root (preferred). G26 / CAO: point at rebuild detection-models (*.engine only).
# Canonical:
#   D:\project\signal_studio_rebuild\out\vs2026-qt611-release_bin\detection-models
LOCAL_COMPUTE_MODEL_DIR=D:\project\signal_studio_rebuild\out\vs2026-qt611-release_bin\detection-models
LOCAL_COMPUTE_MODEL_DIRS=

# Explicit TensorRT engine paths (preferred over discovery).
# FFSCN: ...\detection-models\ffscn-gui-iq-v1\ffscn_epoch1200_dynamic_fp32.engine
# SCN:   ...\detection-models\scn-max-psd-v1\scn_model.engine
LOCAL_COMPUTE_FFSCN_PATH=D:\project\signal_studio_rebuild\out\vs2026-qt611-release_bin\detection-models\ffscn-gui-iq-v1\ffscn_epoch1200_dynamic_fp32.engine
LOCAL_COMPUTE_SCN_PATH=D:\project\signal_studio_rebuild\out\vs2026-qt611-release_bin\detection-models\scn-max-psd-v1\scn_model.engine

# IQ fixtures (G26): ONLY rebuild resources\sigmf_data_demo
LOCAL_COMPUTE_IQ_DIR=D:\project\signal_studio_rebuild\resources\sigmf_data_demo

# Optional expected SHA-256 of the engine blob (mismatch => BLOCKED: WEIGHT_HASH_MISMATCH).
LOCAL_COMPUTE_FFSCN_SHA256=
LOCAL_COMPUTE_SCN_SHA256=
LOCAL_COMPUTE_FFSCN_WEIGHT_SHA256=
LOCAL_COMPUTE_SCN_WEIGHT_SHA256=
LOCAL_COMPUTE_WEIGHT_HASH_MANIFEST=

# Legacy PyTorch algorithm homes (not used when .engine is selected).
LOCAL_COMPUTE_FFSCN_HOME=
LOCAL_COMPUTE_SCN_HOME=

# Real inference gating
LOCAL_COMPUTE_ALLOW_CPU_INFERENCE=0
LOCAL_COMPUTE_DISABLE_TORCH=0
# Set 1 to force TensorRT path off (tests / degrade)
LOCAL_COMPUTE_DISABLE_TENSORRT=0

# Optional FFSCN / SCN TRT decode knobs
LOCAL_COMPUTE_FFSCN_NFFT=2048
LOCAL_COMPUTE_FFSCN_TRT_FRAMES=10
LOCAL_COMPUTE_FFSCN_SCORE_THRESHOLD=0.3
LOCAL_COMPUTE_FFSCN_TOPK=64
LOCAL_COMPUTE_SCN_SCORE_THRESHOLD=0.3
LOCAL_COMPUTE_SCN_TOPK=64

# Stub worker pacing (NON-TensorRT). Tests override these.
LOCAL_COMPUTE_STUB_STEP_MS=50
LOCAL_COMPUTE_STUB_STEPS=8
LOCAL_COMPUTE_CANCEL_JOIN_MS=500
