# If unset, a random Bearer token is generated at startup and logged once.
LOCAL_COMPUTE_TOKEN=
LOCAL_COMPUTE_HOST=127.0.0.1
LOCAL_COMPUTE_PORT=8000
LOCAL_COMPUTE_CORS_ORIGINS=http://localhost:5173
LOCAL_COMPUTE_MODEL_DIRS=
# Optional explicit model paths + expected sha256 (mismatch => BLOCKED reason)
LOCAL_COMPUTE_FFSCN_PATH=
LOCAL_COMPUTE_SCN_PATH=
LOCAL_COMPUTE_FFSCN_SHA256=
LOCAL_COMPUTE_SCN_SHA256=
# Stub worker pacing (NON-TensorRT). Tests override these.
LOCAL_COMPUTE_STUB_STEP_MS=50
LOCAL_COMPUTE_STUB_STEPS=8
