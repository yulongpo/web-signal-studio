# If unset, a random Bearer token is generated at startup and logged once.
LOCAL_COMPUTE_TOKEN=
LOCAL_COMPUTE_HOST=127.0.0.1
LOCAL_COMPUTE_PORT=8000
LOCAL_COMPUTE_CORS_ORIGINS=http://localhost:5173

# Primary model root (preferred). Also accepts LOCAL_COMPUTE_MODEL_DIRS (;-separated).
LOCAL_COMPUTE_MODEL_DIR=
LOCAL_COMPUTE_MODEL_DIRS=

# Optional explicit model paths (PyTorch .pth for current reference trees).
# TensorRT .engine is N/A for surveyed FFSCN/SCN trees — do not point at stub engines.
LOCAL_COMPUTE_FFSCN_PATH=
LOCAL_COMPUTE_SCN_PATH=

# Optional expected SHA-256 of the weight file (mismatch => BLOCKED: WEIGHT_HASH_MISMATCH).
# Aliases: LOCAL_COMPUTE_*_WEIGHT_SHA256. Leave unset to skip the check (optional).
LOCAL_COMPUTE_FFSCN_SHA256=
LOCAL_COMPUTE_SCN_SHA256=
LOCAL_COMPUTE_FFSCN_WEIGHT_SHA256=
LOCAL_COMPUTE_SCN_WEIGHT_SHA256=

# Optional JSON manifest path (default: <MODEL_DIR>/weights.sha256.json | model_hashes.json).
# Example: {"ffscn":"<hex>","scn":"<hex>"} or {"byFile":{"epoch_105.pth":"<hex>"}}
LOCAL_COMPUTE_WEIGHT_HASH_MANIFEST=

# Algorithm source trees for real PyTorch load/inference
LOCAL_COMPUTE_FFSCN_HOME=
LOCAL_COMPUTE_SCN_HOME=

# Real inference gating
# Default: require CUDA. Set to 1 to allow CPU torch readiness.
LOCAL_COMPUTE_ALLOW_CPU_INFERENCE=0
# Force stub even if torch is installed (tests)
LOCAL_COMPUTE_DISABLE_TORCH=0

# Optional FFSCN hyper-params for load/detect
LOCAL_COMPUTE_FFSCN_NFFT=1024
LOCAL_COMPUTE_FFSCN_DETECT_NFFT=1024
LOCAL_COMPUTE_FFSCN_DOWN_NUMS=11

# Stub worker pacing (NON-TensorRT). Tests override these.
LOCAL_COMPUTE_STUB_STEP_MS=50
LOCAL_COMPUTE_STUB_STEPS=8
LOCAL_COMPUTE_CANCEL_JOIN_MS=500
