{
  "name": "web-signal-studio",
  "private": true,
  "version": "0.0.0",
  "description": "Web Signal Studio monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@wss/web --if-present",
    "lint": "npm run lint --workspace=@wss/web --if-present",
    "typecheck": "npm run typecheck --workspace=@wss/web --if-present",
    "test:e2e": "npm run test:e2e --workspace=@wss/web --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}