{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client",
      "node"
    ],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@wss/charts": [
        "../../packages/charts/src/index.ts"
      ],
      "@wss/charts/SpectrumChart": [
        "../../packages/charts/src/react/SpectrumChart.tsx"
      ],
      "@wss/charts/HeatmapCanvas": [
        "../../packages/charts/src/react/HeatmapCanvas.tsx"
      ],
      "@wss/charts/react": [
        "../../packages/charts/src/react/index.ts"
      ],
      "@wss/charts/*": [
        "../../packages/charts/src/*"
      ],
      "@wss/dsp-wasm": [
        "../../packages/dsp-wasm/src/index.ts"
      ],
      "@wss/file-io": [
        "../../packages/file-io/src/index.ts"
      ],
      "@wss/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@wss/charts/lut/colormaps": [
        "../../packages/charts/src/lut/colormaps.ts"
      ],
      "@wss/project-io": [
        "../../packages/project-io/src/index.ts"
      ],
      "@wss/contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src"
  ]
}

